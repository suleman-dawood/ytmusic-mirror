# Maintainer: Suleman Dawood <sulemandawood123@protonmail.com>

pkgname=ytmusic-mirror
pkgver=0.8.0
pkgrel=1
pkgdesc="Mirror public YouTube Music playlists to local MP3 folders (CLI + web dashboard)"
arch=('any')
url="https://github.com/suleman-dawood/ytmusic-mirror"
license=('MIT')
depends=(
  'python>=3.9'
  'yt-dlp'
  'python-mutagen'
  'python-pillow'
  'python-langcodes'
  'python-requests'
  'ffmpeg'
)
optdepends=(
  'deno: yt-dlp JS challenge solving'
  'python-fastapi: web dashboard'
  'python-uvicorn: web dashboard'
  'python-apscheduler: web dashboard scheduler'
)
makedepends=('python-build' 'python-installer' 'python-setuptools')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/suleman-dawood/ytmusic-mirror/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('992f24674187bb64063e31b339861be126804b98163a683157d869fc97772317')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
}
